APP_ENV=development
API_KEYS_JSON={"local-development":"local-dev-key"}
DATABASE_URL=postgresql+psycopg://failure_engine:failure_engine_dev@postgres:5432/failure_engine
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
REPLAY_TARGET_URL=http://fault-proxy:8081
REPLAY_ALLOWED_HOSTS=fault-proxy
REPLAY_ALLOWED_PRIVATE_HOSTS=fault-proxy
REPLAY_ALLOW_PRIVATE_TARGETS=true
FAULT_UPSTREAM_URL=http://target:8080
FAULT_ALLOWED_HOSTS=target
FAULT_ALLOWED_PRIVATE_HOSTS=target
FAULT_PROXY_TOKEN=local-synthetic-proxy-token-rotate-for-dev-only
WORKER_MAX_JOBS=100
