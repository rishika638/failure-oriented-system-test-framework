FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 ENABLE_TEST_FAULTS=true
WORKDIR /app
COPY target/http_service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY fault_injection /app/fault_injection
COPY target/http_service .
EXPOSE 8080
CMD ["python", "app.py"]
